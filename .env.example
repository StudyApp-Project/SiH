# ==============================================================================
# StatVidya — Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Auth, Realtime, Edge Functions)
# ------------------------------------------------------------------------------
# Public Supabase URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (safe for client-side use; governed by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Service Role Key (NEVER expose to client; used in Next.js API & Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Cloudflare Configuration (Workers, R2 Large File Storage, AI Gateway)
# ------------------------------------------------------------------------------
# Public URL for Cloudflare Worker proxy endpoints (r2-upload, ai-proxy)
NEXT_PUBLIC_CLOUDFLARE_WORKER_URL=https://statvidya-proxy.your-subdomain.workers.dev

# Cloudflare Account ID & R2 Bucket Name
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET_NAME=statvidya-documents

# S3-compatible credentials for Cloudflare R2 direct uploads
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare AI Gateway universal endpoint & secret auth token
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your-account-id/statvidya-gateway
CLOUDFLARE_AI_GATEWAY_TOKEN=your-ai-gateway-token

# ------------------------------------------------------------------------------
# 3. External AI Provider Keys (Managed behind Cloudflare AI Gateway)
# ------------------------------------------------------------------------------
# Google Cloud Gemini API key (Primary model: gemini-2.5-flash)
GEMINI_API_KEY=your-gemini-api-key

# Anthropic Claude API key (Secondary fallback: claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API key (Tertiary fallback: gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------------------------------
# 4. Application Behavior & Evaluation Modes
# ------------------------------------------------------------------------------
# Set to 'true' for SIH hackathon evaluation to enable one-click Parichay demo personas
DEMO_MODE=true

# Default application language fallback ('en' or 'hi')
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Public Base URL of the web app (e.g. http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
